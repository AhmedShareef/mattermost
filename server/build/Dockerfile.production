# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-bookworm
ARG GO_IMAGE=golang:1.25-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${NODE_IMAGE} AS webapp-builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    ca-certificates \
    gcc \
    g++ \
    git \
    libpng-dev \
    make \
    nasm \
    python3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src/webapp

COPY webapp /src/webapp

RUN --mount=type=cache,target=/root/.npm \
    npm ci

RUN npm run build --workspace channels

FROM ${GO_IMAGE} AS server-builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG MM_BUILD_NUMBER=custom
ARG MM_BUILD_HASH=

ENV GOFLAGS=-buildvcs=false

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    ca-certificates \
    git \
    make \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY README.md NOTICE.txt /src/
COPY server /src/server
COPY --from=webapp-builder /src/webapp/channels/dist /src/webapp/channels/dist

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    set -euo pipefail; \
    cd /src/server; \
    build_number="${MM_BUILD_NUMBER:-custom}"; \
    build_hash="${MM_BUILD_HASH:-}"; \
    if [[ -z "${build_hash}" ]]; then \
      build_hash="custom"; \
    fi; \
    build_date="$(date -u)"; \
    mmctl_build_date="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"; \
    if git rev-parse HEAD >/dev/null 2>&1; then \
      mmctl_git_commit="$(git rev-parse HEAD)"; \
      mmctl_commit_date="$(TZ=UTC git log -1 --date=format-local:'%Y-%m-%dT%H:%M:%SZ' --format='%cd' 2>/dev/null || echo "${mmctl_build_date}")"; \
      if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then \
        mmctl_git_tree_state="dirty"; \
      else \
        mmctl_git_tree_state="clean"; \
      fi; \
    else \
      mmctl_git_commit="${build_hash}"; \
      mmctl_commit_date="${mmctl_build_date}"; \
      mmctl_git_tree_state="clean"; \
    fi; \
    make BUILD_NUMBER="${build_number}" BUILD_ENTERPRISE=false setup-go-work; \
    ldflags=""; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.BuildNumber=${build_number}"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.BuildDate=${build_date}"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.BuildHash=${build_hash}"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.BuildHashEnterprise=none"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.BuildEnterpriseReady=false"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.MockCWS=false"; \
    ldflags+=" -X github.com/mattermost/mattermost/server/public/model.MattermostGiphySdkKey="; \
    env GOOS=linux GOARCH=amd64 go build -trimpath -tags 'sourceavailable production' -ldflags "${ldflags}" -o bin/mattermost ./cmd/mattermost; \
    mmctl_ldflags=""; \
    mmctl_ldflags+=" -X github.com/mattermost/mattermost/server/v8/cmd/mmctl/commands.buildDate=${mmctl_build_date}"; \
    mmctl_ldflags+=" -X github.com/mattermost/mattermost/server/v8/cmd/mmctl/commands.gitCommit=${mmctl_git_commit}"; \
    mmctl_ldflags+=" -X github.com/mattermost/mattermost/server/v8/cmd/mmctl/commands.gitTreeState=${mmctl_git_tree_state}"; \
    mmctl_ldflags+=" -X github.com/mattermost/mattermost/server/v8/cmd/mmctl/commands.commitDate=${mmctl_commit_date}"; \
    env GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "${mmctl_ldflags}" -o bin/mmctl ./cmd/mmctl; \
    make BUILD_NUMBER="${build_number}" BUILD_ENTERPRISE=false package-prep; \
    make \
      BUILD_NUMBER="${build_number}" \
      BUILD_ENTERPRISE=false \
      DIST_PATH_GENERIC=dist/linux_amd64/mattermost \
      CURRENT_PACKAGE_ARCH=linux_amd64 \
      MM_BIN_NAME=mattermost \
      MMCTL_BIN_NAME=mmctl \
      package-general; \
    test -x dist/linux_amd64/mattermost/bin/mattermost; \
    test -x dist/linux_amd64/mattermost/bin/mmctl; \
    test -f dist/linux_amd64/mattermost/client/root.html

FROM ${RUNTIME_IMAGE} AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG PUID=2000
ARG PGID=2000

ENV PATH="/mattermost/bin:${PATH}"
ENV HOME=/mattermost
ENV MM_INSTALL_TYPE=docker
ENV MM_SERVICESETTINGS_ENABLELOCALMODE=true

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    ca-certificates \
    mailcap \
    media-types \
    poppler-utils \
    tidy \
    tzdata \
    unrtf \
    wv \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${PGID}" mattermost \
  && useradd --uid "${PUID}" --gid "${PGID}" --comment "" --home-dir /mattermost --shell /usr/sbin/nologin mattermost \
  && mkdir -p \
    /mattermost/.postgresql \
    /mattermost/bleve-indexes \
    /mattermost/client/plugins \
    /mattermost/config \
    /mattermost/data \
    /mattermost/logs \
    /mattermost/plugins \
  && chmod 700 /mattermost/.postgresql \
  && chown -R mattermost:mattermost /mattermost

COPY --from=server-builder --chown=2000:2000 /src/server/dist/linux_amd64/mattermost /mattermost

USER mattermost
WORKDIR /mattermost

HEALTHCHECK --interval=30s --timeout=10s \
  CMD ["/mattermost/bin/mmctl", "system", "status", "--local"]

EXPOSE 8065 8067 8074 8075

VOLUME ["/mattermost/config", "/mattermost/data", "/mattermost/logs", "/mattermost/plugins", "/mattermost/client/plugins", "/mattermost/bleve-indexes"]

CMD ["/mattermost/bin/mattermost"]
